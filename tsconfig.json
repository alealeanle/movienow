{
  "compilerOptions": {
    "types": ["vite/client"],
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@api/*": ["src/api/*"],
      "@commons/*": ["src/components/commons/*"],
      "@pages/*": ["src/components/pages/*"],
      "@store/*": ["src/store/*"],
      "@hooks/*": ["src/hooks/*"],
      "@utils/*": ["src/utils/*"],
      "@HomePage/*": ["src/components/pages/HomePage/*"],
      "@FilmNotFoundPage/*": ["src/components/pages/FilmNotFoundPage/*"]
    }
  },
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }]
}
